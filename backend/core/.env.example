# -----------------------------
# Email Configuration
# -----------------------------
# Email address used to send emails (example: Gmail SMTP user)
EMAIL_HOST_USER=""

# App password or SMTP password (never commit real value)
EMAIL_HOST_PASSWORD=""

# -----------------------------
# Application Security
# -----------------------------
# Django / Node / Backend secret key
SECRET_KEY=""

# -----------------------------
# OpenAI Configuration
# -----------------------------
# Your OpenAI API key
OPENAI_API_KEY=""

# OpenAI model name (example: gpt-4o, gpt-4.1-mini)
OPENAI_API_MODEL=""

# -----------------------------
# Google Cloud Configuration
# -----------------------------
# Absolute path to Google service account JSON file
# Example (Windows):
# C:/Users/YourName/keys/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=""
