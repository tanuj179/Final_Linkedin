{
  "manifest_version": 3,
  "name": "Long Screenshot Capture",
  "version": "1.0.0",
  "description": "Capture full-page scrolling screenshots with one click",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "16.png",
      "48": "32.png",
      "128": "48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
